# Server Configuration
PORT=8080
ENV=development

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourapp.com

# WhatsApp Business API Configuration
WA_TOKEN=your-whatsapp-business-token
WA_PHONE_ID=your-phone-id
WA_WEBHOOK_URL=https://yourapp.com/webhooks/whatsapp
WA_VERIFY_TOKEN=your-verify-token

# SMS Configuration (Twilio, SNS, etc.)
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key
SMS_FROM=+1234567890

# Database Configuration
DB_URL=postgres://user:pass@localhost:5432/notify

# Templates
TEMPLATES_DIR=./templates
