# Server Configuration
PORT=8080
ENV=development

# Logging Configuration
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=console  # console or json

# Authentication - REQUIRED
# Format: key1:tenant1,key2:tenant2
# Generate secure keys with: openssl rand -hex 32
API_KEYS=your-secure-api-key:tenant1,another-key:tenant2

# CORS Configuration (optional - leave empty to allow all origins)
CORS_ORIGINS=

# SMTP Configuration - REQUIRED for email channel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourapp.com

# WhatsApp Business API Configuration (optional - for Week 2)
WA_TOKEN=your-whatsapp-business-token
WA_PHONE_ID=your-phone-id
WA_WEBHOOK_URL=https://yourapp.com/webhooks/whatsapp
WA_VERIFY_TOKEN=your-verify-token

# SMS Configuration (optional - for future)
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key
SMS_FROM=+1234567890

# Database Configuration - REQUIRED for Week 3+
# PostgreSQL database for tenant management and multi-tenancy
# Generate secure password with: openssl rand -base64 32
DB_HOST=localhost
DB_PORT=5432
DB_USER=notify
DB_PASSWORD=your-secure-database-password-here
DB_NAME=notify
DB_SSL_MODE=disable  # disable, require, verify-ca, verify-full
DB_MAX_CONNS=25      # Maximum open connections
DB_MAX_IDLE=5        # Maximum idle connections

# Security Configuration - REQUIRED for Week 3+
# Encryption key for sensitive credentials (SMTP passwords, API keys, tokens)
# MUST be at least 32 characters for AES-256 encryption
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-this-in-production

# Templates
TEMPLATES_DIR=./templates
