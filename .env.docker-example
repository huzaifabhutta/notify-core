# Docker Compose Environment Variables
# Copy this file to .env and customize for your deployment

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_PASSWORD=your-secure-database-password-here
DB_PORT=5432

# ============================================
# SECURITY CONFIGURATION (REQUIRED!)
# ============================================
# Generate with: openssl rand -base64 32
# MUST be at least 32 characters for AES-256 encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-this-in-production

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# GLOBAL SMTP CONFIGURATION (Fallback)
# ============================================
# Used as fallback when tenants don't have their own SMTP config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourapp.com

# ============================================
# GLOBAL WHATSAPP CONFIGURATION (Optional)
# ============================================
# Used as fallback when tenants don't have their own WhatsApp config
WA_TOKEN=your-whatsapp-business-token
WA_PHONE_ID=your-phone-id
# Optional: Override API endpoint (defaults to Facebook)
# WA_BASE_URL=https://graph.facebook.com
# WA_BASE_URL=https://waba.360dialog.io  # For 360dialog
# WA_API_VERSION=v21.0

# ============================================
# GLOBAL SMS CONFIGURATION (Optional)
# ============================================
# Used as fallback when tenants don't have their own SMS config
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key
SMS_FROM=+1234567890

# ============================================
# DATABASE TUNING (Optional)
# ============================================
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MAX_IDLE=5
